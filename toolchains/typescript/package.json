{
  "name": "@compforge/spec-case",
  "version": "0.0.1",
  "description": "TypeScript spec/case/rule/link markers and the specgen static extractor.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/compforge/spec-case",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/compforge/spec-case.git",
    "directory": "toolchains/typescript"
  },
  "exports": {
    ".": {
      "types": "./dist/src/markers.d.ts",
      "import": "./dist/src/markers.js"
    },
    "./specgen": {
      "types": "./dist/src/specgen.d.ts",
      "import": "./dist/src/specgen.js"
    }
  },
  "bin": {
    "specgen": "./dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "typescript": ">=6.0.3 <7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
