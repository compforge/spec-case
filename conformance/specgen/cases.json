        "python": "fixture.py::run",
        "go": "fixture.go::Run",
        "typescript": "fixture.ts::run"
      },
      "expected_entry": {
        "specs": [
          {
            "cases": [],
            "whys": ["the stable key keeps retries idempotent"]
          }
        ]
      }
    },
    {
