{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://compforge.github.io/spec-case/http-case.schema.json",
  "title": "Canonical HTTP Case profile",
  "allOf": [
    {
      "$ref": "case.schema.json#/definitions/case"
    }
  ],
  "properties": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "method"
      ],
      "properties": {
        "protocol": {
          "const": "http"
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/(?!/)[^\\\\\\x00-\\x1f\\x7f]*$"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "type": "string"
        }
      }
    },
    "judge": {
      "properties": {
        "e2e": {
          "properties": {
            "http": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  }
                },
                "contentType": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
