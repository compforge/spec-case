{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/compforge/spec-case/spec/spec-json.schema.json",
  "title": "spec.json",
  "description": "The generated artifact produced by specgen and ingested by contract consumers. Indexed by symbol-id.",
  "type": "object",
  "definitions": {
    "case": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "desc": { "type": "string" },
        "input": { "type": "string", "description": "NL request shape." },
        "expect": { "type": "string", "description": "NL expected outcome." },
        "forbid": { "type": "string", "description": "NL what must not happen." }
      }
    },
    "spec": {
      "type": "object",
      "required": ["cases"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Optional authored identity within one symbol. Required and unique when that symbol carries multiple specs."
        },
        "spec": {
          "type": "string",
          "description": "The contract preamble in natural language. May be absent when only cases, links, or rules exist."
        },
        "cases": {
          "type": "array",
          "description": "Cases governed by this spec.",
          "items": { "$ref": "#/definitions/case" }
        },
        "links": {
          "type": "array",
          "description": "Author-curated see-also references for this spec.",
          "items": { "type": "string" }
        },
        "rules": {
          "type": "array",
          "description": "Review criteria attached to this spec.",
          "items": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": {
    "type": "object",
    "required": ["specs"],
    "additionalProperties": false,
    "properties": {
      "fqn": {
        "type": "string",
        "description": "The symbol's language-native fully-qualified name when the toolchain can resolve one reliably."
      },
      "specs": {
        "type": "array",
        "minItems": 1,
        "description": "Contracts bound to this code symbol.",
        "items": { "$ref": "#/definitions/spec" }
      }
    }
  },
  "propertyNames": {
    "pattern": "^[^:]+::[^:]+$",
    "description": "Each key is a symbol-id: <relpath>::<symbol>."
  }
}
